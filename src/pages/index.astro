---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialIcon from "../components/SocialIcon.astro";
import ProofStrip from "../components/ProofStrip.astro";
import CareerRail from "../components/CareerRail.astro";
import OrgGroup from "../components/OrgGroup.astro";
import ProjectFeature from "../components/ProjectFeature.astro";
import PublicationEntry from "../components/PublicationEntry.astro";
import CredentialRows from "../components/CredentialRows.astro";
import { profile, careerRail, credentials, SITE } from "../lib/site";

const roles = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order,
);

// Group consecutive roles that share a `group`. Order comes from the roles
// themselves, so W. L. Gore appearing twice (2011-2022, then 2024-now) produces
// two separate groups rather than one merged block.
const groups: (typeof roles)[] = [];
for (const role of roles) {
  const last = groups.at(-1);
  if (last && last[0].data.group === role.data.group) last.push(role);
  else groups.push([role]);
}

const projects = await getCollection("projects");
const publications = (await getCollection("publications")).sort(
  (a, b) => a.data.order - b.data.order,
);

const socials = [
  { icon: "mail", href: `mailto:${profile.email}`, label: "Email" },
  { icon: "github", href: profile.links.github, label: "GitHub" },
  { icon: "linkedin", href: profile.links.linkedin, label: "LinkedIn" },
  { icon: "stack", href: profile.links.stackoverflow, label: "Stack Overflow" },
] as const;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.roleLine[0],
  worksFor: { "@type": "Organization", name: "W. L. Gore & Associates" },
  alumniOf: { "@type": "CollegeOrUniversity", name: profile.education.institution },
  address: { "@type": "PostalAddress", addressLocality: "Sunbury", addressRegion: "OH" },
  email: `mailto:${profile.email}`,
  url: SITE.url,
  knowsAbout: profile.interests,
  sameAs: [profile.links.github, profile.links.linkedin, profile.links.stackoverflow],
  // validThrough encodes expiry honestly, matching what the page shows.
  hasCredential: credentials.map((c) => ({
    "@type": "EducationalOccupationalCredential",
    name: c.name,
    credentialCategory: "certification",
    recognizedBy: { "@type": "Organization", name: "Amazon Web Services" },
    validThrough: c.status.replace(/^Expired\s+/, ""),
  })),
};
---

<BaseLayout spy jsonLd={jsonLd}>
  <section id="about" class="band band--a">
    <div class="wrap">
      <div class="hero">
        <figure class="portrait">
          <img
            src="/assets/caesar-kabalan.webp"
            alt={profile.name}
            width="720"
            height="1080"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
        <div class="hero-body">
          <p class="hero-kicker">{profile.kicker}</p>
          <h1 class="hero-name">{profile.name}</h1>
          <p class="hero-role">
            {
              profile.roleLine.map((part, i) => (
                <>
                  {i > 0 && <span class="sep" />}
                  <span>{part}</span>
                </>
              ))
            }
          </p>
          <p class="hero-pos">{profile.positioning}</p>
          <ProofStrip items={profile.proof} />
          <div class="actions actions--hero">
            <a class="btn btn--filled" href={profile.links.resume}>Resume (PDF)</a>
            {
              socials.map((s) => (
                <a class="btn btn--icon" href={s.href} rel="noopener">
                  <SocialIcon name={s.icon} />
                  <span>{s.label}</span>
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <div class="rail-grid about-more">
        <div><h2 class="rail-label">Biography</h2></div>
        <div class="rail-body">
          {profile.biography.map((p) => <p class="prose">{p}</p>)}
          <p class="interests">
            <span class="interests-label">Interests</span>
            {profile.interests.join(" · ")}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="experience" class="band band--b">
    <div class="wrap rail-grid">
      <div><h2 class="rail-label">Experience</h2></div>
      <div class="rail-body">
        <CareerRail segments={careerRail} />
        {groups.map((g) => <OrgGroup roles={g} />)}
      </div>
    </div>
  </section>

  <section id="work" class="band band--a">
    <div class="wrap rail-grid">
      <div><h2 class="rail-label">Selected Work</h2></div>
      <div class="rail-body">
        {projects.map((p) => <ProjectFeature entry={p} />)}
        <hr class="hair" />
        <h3 class="eyebrow">Publications</h3>
        <div class="pubs">
          {publications.map((p) => <PublicationEntry entry={p} />)}
        </div>
      </div>
    </div>
  </section>

  <section id="credentials" class="band band--b">
    <div class="wrap rail-grid">
      <div><h2 class="rail-label">Credentials</h2></div>
      <div class="rail-body">
        <CredentialRows education={profile.education} items={credentials} />
      </div>
    </div>
  </section>

  <section id="contact" class="band band--a">
    <div class="wrap rail-grid">
      <div><h2 class="rail-label">Contact</h2></div>
      <div class="rail-body">
        <p class="contact-lead">{profile.contactLead}</p>
        <ul class="contact">
          <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
          <li>
            <a href={profile.links.linkedin} rel="noopener">
              linkedin.com/in/caesarkabalan
            </a>
          </li>
          <li><span class="muted">{profile.location}</span></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
