---
import type { Credential, Profile } from "../lib/site";
interface Props { education: Profile["education"]; items: Credential[] }
const { education, items } = Astro.props;
---
<ul class="creds">
  <li class="cred cred--edu">
    <p class="cred-name">{education.degree}</p>
    <p class="cred-meta">
      <span>{education.institution}</span><span>{education.year}</span>
    </p>
  </li>
  {items.map((c) => (
    <li class="cred">
      <p class="cred-name">{c.name}</p>
      <p class="cred-meta">
        <span>{c.earned}</span><span class="expired">{c.status}</span>
      </p>
      <p class="cred-actions">
        <a class="cred-about" href={c.about} rel="noopener">About this certification</a>
        {c.verify && <a class="cred-verify" href={c.verify} rel="noopener">Verify on Credly</a>}
      </p>
    </li>
  ))}
</ul>
